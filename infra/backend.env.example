# 复制为 infra/backend.env。它会同时注入 API 和 Worker，绝不能提交真实密钥。
# 模型配置中心的 secret_env_name 必须和这里的变量名完全一致；模型 ID、Base URL 与参数仍在模型 Profile 中配置。
# 云雾推理/视觉理解模型：同一 Key 可供多个推理模型 Profile 使用。
YUNWU_REASONING_API_KEY=
# 火山方舟：官方 Seedream 图片和 Seedance 视频 Profile 可共用同一渠道 Key。
ARK_API_KEY=

# 仅当三种媒体存储模式改为 s3 时填写标准 S3/MinIO 凭据。
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=ai-drama-media
# S3_PUBLIC_BASE_URL=https://cdn.example.com/ai-drama-media
