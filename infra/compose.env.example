# 复制为 infra/compose.env 后再执行 docker compose --env-file infra/compose.env up --build。
# 仅用于本机验收；生产请把这些值放进云平台的 Secret/密钥服务。
POSTGRES_PASSWORD=replace-with-a-long-local-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-local-password
S3_BUCKET=ai-drama-media

# 可选：限制上传与单个 RQ 任务的上限。其余后端配置在 docker-compose.yml 中已明确。
MAX_UPLOAD_BYTES=524288000
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKFLOW_STALE_AFTER_SECONDS=2100
