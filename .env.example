# 开发默认使用 SQLite；生产环境改为 PostgreSQL，例如：postgresql+psycopg://user:password@db:5432/ai_drama
DATABASE_URL=sqlite:///./data/ai_drama.db

# auto 仅用于本地零配置开发。生产数据库必须使用 migrate，并在发布前执行：
# cd server && DATABASE_SCHEMA_MODE=migrate alembic upgrade head
DATABASE_SCHEMA_MODE=auto
# DATABASE_SCHEMA_MODE=migrate

# 开发时视频先保存到本地目录；生产多 Worker 时可改为 s3，Worker 会按需下载临时
# 副本供 FFmpeg 使用，并在任务结束时清理。S3 配置见文件末尾。
LOCAL_STORAGE_PATH=./data/assets
SOURCE_VIDEO_STORAGE_MODE=local
# SOURCE_VIDEO_STORAGE_MODE=s3

# 上传文件的服务端上限（默认 500 MB）。生产环境还应使用网关和对象存储直传策略限制。
MAX_UPLOAD_BYTES=524288000

# inline 仅用于本地演示。生产必须由独立 Redis Worker 消费任务。
TASK_EXECUTION_MODE=inline

# 生产使用独立 RQ Worker 时切换为 rq，并配置 Redis；API 进程不再执行模型任务。
# TASK_EXECUTION_MODE=rq
# REDIS_URL=redis://127.0.0.1:6379/0
# RQ_QUEUE_NAME=ai_drama
WORKER_JOB_TIMEOUT_SECONDS=1800

# 仅用于自动识别“Worker 已中断、页面却一直显示执行中”的卡死任务。它不会自动
# 重试模型调用，避免中转站超时后重复扣费；到期任务会变为 FAILED，需人工确认重试。
# 必须至少比 WORKER_JOB_TIMEOUT_SECONDS 多 60 秒。
WORKFLOW_STALE_AFTER_SECONDS=2100

# 允许前端本地开发服务器访问 API。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 模型配置中心只填写 `secret_env_name`（例如 RELAY_VIDEO_API_KEY）；真实 Key 只在
# 本地未提交的 .env 或生产密钥管理器中设置。接入适配器前下列变量不会被读取。
# 云雾 OpenAI 兼容文本接口（用于选题、故事、分镜）。复制到未提交的 .env 后填写真实值。
# YUNWU_API_KEY=
# RELAY_VIDEO_API_KEY=

# 图片模型返回的 URL 可能有时效。开发阶段保持 direct；生产建议改为 s3，图片在
# 生成完成后会立即复制到自己的 S3/MinIO，并把 S3_PUBLIC_BASE_URL 交给视频模型。
GENERATED_IMAGE_DELIVERY_MODE=direct
GENERATED_IMAGE_MAX_BYTES=26214400
GENERATED_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=90

# 完整成片默认保存到本机媒体目录，可通过受控 API 下载。生产多 Worker 部署时改为
# s3，并复用下方 Bucket/CDN 配置，避免成片只存在于某一台 Worker 本地磁盘。
FINAL_VIDEO_DELIVERY_MODE=local
# FINAL_VIDEO_DELIVERY_MODE=s3
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=ai-drama-media
# S3_PUBLIC_BASE_URL=https://cdn.example.com/ai-drama-media
# AWS_ACCESS_KEY_ID=仅在未提交的 .env 或生产密钥管理器设置
# AWS_SECRET_ACCESS_KEY=仅在未提交的 .env 或生产密钥管理器设置
